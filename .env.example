# --- Variables de entorno para despliegue en nube (S3) ---
# Copia este archivo a .env y rellena los valores antes de desplegar.

# Bucket S3 donde se guardan los Parquet y el catálogo (ej: mingadata-resultados)
MINGA_DATA_BUCKET=tu-bucket-s3

# Prefijo opcional dentro del bucket (ej: produccion/v1). Dejar vacío si no se usa.
MINGA_DATA_PREFIX=

# Región AWS del bucket (ej: us-east-1, sa-east-1)
MINGA_DATA_REGION=us-east-1
