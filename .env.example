# --- Variables de entorno para despliegue en nube (SI7006-6 "Excelente") ---
# Copia este archivo a .env y rellena los valores antes de desplegar.
# Nunca subas este archivo con credenciales reales a GitHub.

# =============================================================================
# 1. Almacenamiento S3 (modelo persistido y versionado)
# =============================================================================

# Bucket S3 donde se guardan Parquet, catálogo, modelo y logs
MINGA_DATA_BUCKET=tu-bucket-s3

# Prefijo opcional dentro del bucket (ej: produccion/v1). Dejar vacío si no se usa.
MINGA_DATA_PREFIX=

# Región AWS del bucket (ej: us-east-1, sa-east-1)
MINGA_DATA_REGION=us-east-1

# URL S3 directa del modelo para la API (ej: s3://bucket/modelos/20261120_173855/modelo_lgbm.joblib)
MINGA_MODELO_S3_URL=

# =============================================================================
# 2. API REST (FastAPI)
# =============================================================================

# URL de la API desde el dashboard (para consumir predicciones en la nube)
# En local: http://localhost:8000
# En Streamlit Cloud: https://tu-api.render.com o similar
MINGA_API_URL=http://localhost:8000

# =============================================================================
# 3. MLflow (tracking y versionado de modelos)
# =============================================================================

# URL del servidor MLflow (opcional; si no se usa, se usa tracking local en file://)
MLFLOW_TRACKING_URI=

# Nombre del experimento en MLflow
MLFLOW_EXPERIMENT_NAME=mingadata_modelo

# =============================================================================
# 4. Credenciales AWS (para boto3)
# =============================================================================
# No guardar aquí valores reales en producción. Usar secrets del entorno de despliegue.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
