<mxfile host="app.diagrams.net"><diagram name="Diagrama 3"><mxGraphModel dx="1600" dy="900" grid="0" page="1" pageWidth="1640" pageHeight="696"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Pantalla 1 · Oferta&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=#FFFFFF;strokeColor=#1D4E89;strokeWidth=2;fontSize=16;fontColor=#173F6E;" vertex="1" parent="1"><mxGeometry x="30" y="78" width="510" height="520" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;SE ELIGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Año de pronóstico: 2024&lt;br&gt;&lt;br&gt;Escenario de oferta: base&lt;br&gt;&lt;br&gt;Producto: Aguacate&lt;br&gt;&lt;br&gt;Municipio: Bugalagrande" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="38" y="124" width="184" height="466" as="geometry"/></mxCell><mxCell id="n4" value="Esquema: línea histórica y pronóstico con intervalo" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=#FFFFFF;strokeColor=#D1D5DB;dashed=1;fontSize=12;fontColor=#6B7280;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="156" width="286" height="190" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;SE VE&lt;/b&gt;&lt;ul style=&#x27;margin:4px 0 0 0;padding-left:16px&#x27;&gt;&lt;li&gt;Serie histórica desde 2000 y pronóstico con su intervalo entre bajo y alto&lt;/li&gt;&lt;li&gt;Tabla del pronóstico por año, en toneladas&lt;/li&gt;&lt;li&gt;Tabla de los últimos 10 años de la serie histórica&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=none;strokeColor=none;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="240" y="354" width="286" height="232" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;¿Cuánto va a producir cada municipio?&lt;/b&gt;" style="text;html=1;align=center;fontFamily=Inter;fontSize=15;fontColor=#173F6E;" vertex="1" parent="1"><mxGeometry x="30" y="608" width="510" height="30" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Pantalla 2 · Zonas de acopio&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=#FFFFFF;strokeColor=#2A9D8F;strokeWidth=2;fontSize=16;fontColor=#1F756B;" vertex="1" parent="1"><mxGeometry x="565" y="78" width="510" height="520" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;SE ELIGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Año: 2024&lt;br&gt;&lt;br&gt;Escenario de optimización: oferta base, 80/20" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="573" y="124" width="184" height="466" as="geometry"/></mxCell><mxCell id="n9" value="Esquema: mapa de las 5 zonas" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=#FFFFFF;strokeColor=#D1D5DB;dashed=1;fontSize=12;fontColor=#6B7280;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="775" y="156" width="286" height="190" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;SE VE&lt;/b&gt;&lt;ul style=&#x27;margin:4px 0 0 0;padding-left:16px&#x27;&gt;&lt;li&gt;Mapa de las 5 zonas contiguas y el municipio de referencia de cada una&lt;/li&gt;&lt;li&gt;Volumen de cada zona para el mercado nacional y para exportación&lt;/li&gt;&lt;li&gt;Tabla de municipio y zona, que se descarga en CSV&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=none;strokeColor=none;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="775" y="354" width="286" height="232" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;¿Qué municipios se acopian juntos?&lt;/b&gt;" style="text;html=1;align=center;fontFamily=Inter;fontSize=15;fontColor=#1F756B;" vertex="1" parent="1"><mxGeometry x="565" y="608" width="510" height="30" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Pantalla 3 · Ubicación&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=#FFFFFF;strokeColor=#C98A1B;strokeWidth=2;fontSize=16;fontColor=#8F6210;" vertex="1" parent="1"><mxGeometry x="1100" y="78" width="510" height="520" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;SE ELIGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Año del análisis: 2024&lt;br&gt;&lt;br&gt;Escenario de producción: base&lt;br&gt;&lt;br&gt;Consumo local: base&lt;br&gt;&lt;br&gt;Nacional y exportación: 80 % y 20 %&lt;br&gt;&lt;br&gt;Organización de acopios: Libre / Por zonas&lt;br&gt;&lt;br&gt;Número de acopios: de 3 a 8&lt;br&gt;&lt;br&gt;Prioridad del transporte: de destinos a recolección&lt;br&gt;&lt;br&gt;Botón: Calcular ubicación" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="1108" y="124" width="184" height="466" as="geometry"/></mxCell><mxCell id="n14" value="Esquema: mapa de la red" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=#FFFFFF;strokeColor=#D1D5DB;dashed=1;fontSize=12;fontColor=#6B7280;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="156" width="286" height="190" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;SE VE&lt;/b&gt;&lt;ul style=&#x27;margin:4px 0 0 0;padding-left:16px&#x27;&gt;&lt;li&gt;Municipio de la central, acopios abiertos y volumen considerado&lt;/li&gt;&lt;li&gt;Mapa de la red: municipios, acopios, central y destinos&lt;/li&gt;&lt;li&gt;Transporte de cada tramo, en toneladas × minutos&lt;/li&gt;&lt;li&gt;Alternativas: otras prioridades, libre frente a zonas y estabilidad&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;fillColor=none;strokeColor=none;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="1310" y="354" width="286" height="232" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;¿Dónde van la central y sus acopios?&lt;/b&gt;" style="text;html=1;align=center;fontFamily=Inter;fontSize=15;fontColor=#8F6210;" vertex="1" parent="1"><mxGeometry x="1100" y="608" width="510" height="30" as="geometry"/></mxCell><mxCell id="n17" value="Es un boceto: los dibujos son esquemas, no datos. El tablero publicado tiene además un resumen, el mapa de la oferta y la pantalla de cobertura y capacidad." style="text;html=1;align=center;fontFamily=Inter;fontSize=12;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="30" y="654" width="1580" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>