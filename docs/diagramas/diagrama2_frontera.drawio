<mxfile host="app.diagrams.net"><diagram name="Frontera ML y optimización"><mxGraphModel dx="1440" dy="684" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="684" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Aprendizaje automático" style="rounded=1;arcSize=2;html=1;align=center;verticalAlign=top;spacingTop=6;fillColor=#F9FAFB;strokeColor=#D1D5DB;strokeWidth=1;dashed=1;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="24" y="44" width="404" height="472" as="geometry"/></mxCell><mxCell id="n3" value="&lt;font style=&quot;font-size:16px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Zonas de acopio&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Ward con vecindad tipo reina:&lt;br&gt;5 zonas contiguas" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#E6F4F2;strokeColor=#2A9D8F;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="372" height="104" as="geometry"/></mxCell><mxCell id="n4" value="&lt;font style=&quot;font-size:16px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Pronóstico&lt;/b&gt;&lt;/font&gt;&lt;br&gt;oferta por producto, municipio y año,&lt;br&gt;2024-2028 en bajo, base y alto&lt;br&gt;(intervalo del 80 %; cubre el 76 %)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#E8EEF6;strokeColor=#1D4E89;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="241" width="372" height="104" as="geometry"/></mxCell><mxCell id="n5" value="&lt;font style=&quot;font-size:16px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Excedentes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;oferta menos consumo local, con piso&lt;br&gt;en cero, para 3 niveles de oferta&lt;br&gt;y 3 de consumo" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#E6F4F2;strokeColor=#2A9D8F;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="372" height="104" as="geometry"/></mxCell><mxCell id="n6" value="valor de la oferta" style="edgeStyle=none;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter;fontSize=12;fontStyle=2;fontColor=#4B5563;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="239" as="sourcePoint"/><mxPoint x="110" y="200" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="n7" value="toneladas" style="edgeStyle=none;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter;fontSize=12;fontStyle=2;fontColor=#4B5563;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="347" as="sourcePoint"/><mxPoint x="110" y="386" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="n8" value="&lt;font style=&quot;font-size:16px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Zonas&lt;/b&gt;&lt;/font&gt;&lt;br&gt;zona de cada municipio&lt;br&gt;(zonas.csv)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#2A9D8F;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="468" y="96" width="250" height="92" as="geometry"/></mxCell><mxCell id="n9" value="&lt;font style=&quot;font-size:16px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Excedentes q&lt;sub&gt;m&lt;/sub&gt;&lt;/b&gt;&lt;/font&gt;&lt;br&gt;toneladas por municipio, año&lt;br&gt;y escenario: 9 por año" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#2A9D8F;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="468" y="398" width="250" height="92" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=none;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter;fontSize=12;fontStyle=2;fontColor=#4B5563;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="414" y="142" as="sourcePoint"/><mxPoint x="462" y="142" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="n11" value="" style="edgeStyle=none;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter;fontSize=12;fontStyle=2;fontColor=#4B5563;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="414" y="444" as="sourcePoint"/><mxPoint x="462" y="444" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="n12" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Variables de decisión&lt;/b&gt;&lt;/font&gt;&lt;br&gt;x&lt;sub&gt;c&lt;/sub&gt; = 1 si la central queda en el municipio c&lt;br&gt;y&lt;sub&gt;s&lt;/sub&gt; = 1 si se abre un acopio satélite en el municipio s&lt;br&gt;z&lt;sub&gt;m,s&lt;/sub&gt; = 1 si el municipio m entrega su excedente al satélite s&lt;br&gt;w&lt;sub&gt;s,c&lt;/sub&gt; = 1 si el satélite s envía a la central c&lt;br&gt;f&lt;sub&gt;s,c&lt;/sub&gt; ≥ 0: toneladas que van del satélite s a la central c" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#C98A1B;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="778" y="90" width="622" height="139" as="geometry"/></mxCell><mxCell id="n13" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Dos objetivos que compiten, en toneladas × minutos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A, recolección: de los municipios a los satélites y de ahí a la central&lt;br&gt;B, distribución: de la central a Cali, Bogotá, Medellín, Buenaventura&lt;br&gt;y el aeropuerto de Palmira&lt;br&gt;Se minimiza λ·A + (1 − λ)·B, con λ entre 0 y 1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#C98A1B;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="778" y="241" width="622" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Restricciones&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Se abre una sola central&lt;br&gt;Se abren 5 satélites (modo libre) o uno por zona (modo zonas)&lt;br&gt;Cada municipio entrega a un satélite abierto&lt;br&gt;Cada satélite abierto envía a la central&lt;br&gt;Lo que entra a cada satélite sale hacia la central&lt;br&gt;Sin capacidades por acopio: no hay valores que las respalden" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#C98A1B;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="778" y="373" width="622" height="158" as="geometry"/></mxCell><mxCell id="n15" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Resultado: central y 5 satélites por escenario&lt;/b&gt;&lt;/font&gt;&lt;br&gt;frontera de Pareto entre A y B, y estabilidad de la central en 54 escenarios" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FAF2E1;strokeColor=#C98A1B;strokeWidth=2;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="778" y="543" width="622" height="63" as="geometry"/></mxCell><mxCell id="n16" value="Modelo de localización (OR-Tools con SCIP)" style="rounded=1;arcSize=2;html=1;align=center;verticalAlign=top;spacingTop=6;fillColor=#FAF2E1;strokeColor=#C98A1B;strokeWidth=2;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="762" y="44" width="654" height="578" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=none;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter;fontSize=12;fontStyle=2;fontColor=#4B5563;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="142" as="sourcePoint"/><mxPoint x="756" y="142" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="n18" value="" style="edgeStyle=none;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter;fontSize=12;fontStyle=2;fontColor=#4B5563;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="444" as="sourcePoint"/><mxPoint x="756" y="444" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="n19" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#111827&quot;&gt;&lt;b&gt;Supuestos que no salen de los modelos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mezcla nacional / exportación: 80/20, 50/50 y 20/80, que da 27 escenarios por año&lt;br&gt;Tiempos de viaje: línea recta × 1,4 a 45 km/h, entre 42 municipios y 5 destinos" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=2;dashed=1;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="24" y="540" width="694" height="82" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=none;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontFamily=Inter;fontSize=12;fontStyle=2;fontColor=#4B5563;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="581" as="sourcePoint"/><mxPoint x="756" y="581" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="n21" value="Borde punteado: supuesto externo" style="text;html=1;align=center;fontFamily=Inter;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="570" y="648" width="300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>